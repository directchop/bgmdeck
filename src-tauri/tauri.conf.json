{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BGM Deck",
  "version": "0.9.0",
  "identifier": "com.directchop.bgmdeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BGM Deck",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDREIzRTYyNkNFMTMyMEEKUldRS011RnNZajdiWEo0WnRkemNHS0pacFR0TEtSOEFablN2WG1zZ1VUOVJvc2tzd1FadHpDdmQK",
      "endpoints": [
        "https://bgmdeck-updates.stereopeppermint.workers.dev/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
